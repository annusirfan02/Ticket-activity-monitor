# ── Freshdesk ──
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_api_key

# ── Deputy ──
DEPUTY_DOMAIN=yourcompany.na.deputy.com
DEPUTY_ACCESS_TOKEN=your_deputy_token

# ── Slack ──
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Supabase (Settings → API in your Supabase project) ──
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ── Monitoring config ──
INACTIVITY_THRESHOLD_MINUTES=30
POLL_INTERVAL_MINUTES=5
BREAK_GRACE_MINUTES=15
LATE_GRACE_MINUTES=5
DISPLAY_TZ=America/Los_Angeles

# ── Admin login (CHANGE PASSWORD after deploy) ──
ADMIN_EMAIL=Annus@mycrmsupport.com
ADMIN_PASSWORD=Annus"123

# ── Cron security ──
CRON_SECRET=random_string_here
